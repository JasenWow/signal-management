{
  "name": "signal-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.node.json",
    "start": "bun dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dep-check": "depcruise --config .dependency-cruiser.cjs src"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.9",
    "jsondiffpatch": "^0.6.0",
    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.15.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/bun": "^1.2.15",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "dependency-cruiser": "^17.4.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
